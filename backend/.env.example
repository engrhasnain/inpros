# Copy to .env and adjust. The database is SQLite.
# Local (default): backend/inpros.db
# DATABASE_URL=sqlite:///D:/inpros-data/inpros.db
# STORAGE_DIR=D:\inpros-data\storage

# Vercel: remote SQLite on Turso (Vercel keeps no files between requests)
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=<token>
